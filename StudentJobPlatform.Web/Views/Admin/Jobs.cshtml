@model List<StudentJobPlatform.Models.Job>

@{
    ViewData["Title"] = "Jobs";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jobs</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #07111f, #0b1b33);
            color: white;
            min-height: 100vh;
            padding: 30px 20px;
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
        }

        .header {
            margin-bottom: 20px;
        }

            .header h1 {
                margin-bottom: 8px;
            }

            .header p {
                color: #cbd5e1;
            }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            color: white;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 700;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
        }

        .table-wrap {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            padding: 22px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 14px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        th {
            color: #93c5fd;
            font-size: 14px;
        }

        td {
            color: #e2e8f0;
        }

        tr:hover {
            background: rgba(255,255,255,0.04);
        }
    </style>
</head>
<body>
    <div class="container">

        <a href="/Admin/Dashboard" class="back-btn">⬅ Back to Dashboard</a>

        <div class="header">
            <h1>All Jobs</h1>
            <p>List of all jobs in the system.</p>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <p>No jobs found.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Company</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Working Hours</th>
                            <th>Salary</th>
                            <th>Employer ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td>@job.Id</td>
                                <td>@job.Title</td>
                                <td>@job.Company</td>
                                <td>@job.Description</td>
                                <td>@job.Category</td>
                                <td>@job.Location</td>
                                <td>@job.WorkingHours</td>
                                <td>@job.Salary €</td>
                                <td>@job.EmployerId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>