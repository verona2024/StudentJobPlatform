@model List<StudentJobPlatform.Models.Job>

@{
    ViewData["Title"] = "Category Jobs";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Category - Student Job Platform</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #07111f;
            color: white;
            min-height: 100vh;
        }

        .topbar {
            position: sticky;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(7, 17, 31, 0.82);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            font-size: 28px;
        }

        .logo-text {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
        }

        .top-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            text-decoration: none;
            padding: 12px 22px;
            border-radius: 14px;
            font-weight: 700;
            transition: 0.25s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: white;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.30);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                color: white;
            }

        .btn-secondary {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.16);
            color: white;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                color: white;
                background: rgba(255,255,255,0.08);
            }

        .page-header {
            padding: 70px 20px 30px;
            text-align: center;
            background: radial-gradient(circle at top center, rgba(59,130,246,0.20), transparent 35%), linear-gradient(180deg, #07111f 0%, #0b1b33 100%);
        }

            .page-header .badge {
                display: inline-block;
                margin-bottom: 18px;
                padding: 10px 18px;
                border-radius: 999px;
                background: rgba(59,130,246,0.14);
                border: 1px solid rgba(96,165,250,0.24);
                color: #bfdbfe;
                font-size: 14px;
                font-weight: 600;
            }

            .page-header h1 {
                font-size: 48px;
                margin-bottom: 14px;
                color: #f8fafc;
            }

            .page-header p {
                max-width: 760px;
                margin: 0 auto;
                color: #cbd5e1;
                font-size: 18px;
                line-height: 1.7;
            }

        .content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px 80px;
        }

        .jobs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .job-card {
            background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.04));
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 22px;
            padding: 26px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.18);
            transition: 0.25s ease;
        }

            .job-card:hover {
                transform: translateY(-5px);
                border-color: rgba(59,130,246,0.35);
                box-shadow: 0 16px 34px rgba(37,99,235,0.14);
            }

            .job-card h3 {
                margin-bottom: 16px;
                color: #60a5fa;
                font-size: 24px;
            }

        .job-info {
            margin-bottom: 10px;
            color: #e2e8f0;
            font-size: 16px;
            line-height: 1.6;
        }

        .job-actions {
            margin-top: 20px;
        }

        .apply-btn {
            display: inline-block;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 12px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: white;
            font-weight: 700;
            transition: 0.25s ease;
        }

            .apply-btn:hover {
                transform: translateY(-2px);
                color: white;
            }

        .empty-box {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
            padding: 40px;
            border-radius: 22px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: #cbd5e1;
            box-shadow: 0 10px 26px rgba(0,0,0,0.16);
        }

            .empty-box h3 {
                font-size: 28px;
                margin-bottom: 12px;
                color: #f8fafc;
            }

        .footer {
            text-align: center;
            padding: 24px 16px;
            color: #94a3b8;
            border-top: 1px solid rgba(255,255,255,0.06);
            background: #07111f;
            font-size: 14px;
        }

        @@media (max-width: 992px) {
            .jobs-grid {
                grid-template-columns: 1fr;
            }

            .page-header h1 {
                font-size: 38px;
            }
        }

        @@media (max-width: 600px) {
            .topbar {
                padding: 16px 18px;
                flex-direction: column;
                gap: 14px;
            }

            .logo-text {
                font-size: 18px;
            }

            .top-actions {
                width: 100%;
                justify-content: center;
            }

            .btn {
                width: 100%;
                text-align: center;
            }

            .page-header {
                padding: 50px 16px 24px;
            }

                .page-header h1 {
                    font-size: 30px;
                }

                .page-header p {
                    font-size: 16px;
                }

            .job-card {
                padding: 20px;
            }

                .job-card h3 {
                    font-size: 21px;
                }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="logo">
            <span class="logo-icon">💼</span>
            <a href="/" class="logo-text">Student Job Platform</a>
        </div>

        <div class="top-actions">
            <a href="/" class="btn btn-secondary">Back to Home</a>
            <a href="/Auth/Login" class="btn btn-primary">Login</a>
        </div>
    </header>

    <section class="page-header">
        <div class="badge">Category Overview</div>
        <h1>@ViewBag.Category</h1>
        <p>
            Browse available opportunities in this category and explore positions
            that match your goals, schedule, and interests.
        </p>
    </section>

    <main class="content">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-box">
                <h3>No jobs found</h3>
                <p>There are currently no job listings available in this category.</p>
            </div>
        }
        else
        {
            <div class="jobs-grid">
                @foreach (var job in Model)
                {
                    <div class="job-card">
                        <h3>@job.Title</h3>
                        <div class="job-info"><strong>Category:</strong> @job.Category</div>
                        <div class="job-info"><strong>Location:</strong> @job.Location</div>
                        <div class="job-info"><strong>Working Hours:</strong> @job.WorkingHours</div>
                        <div class="job-info"><strong>Salary:</strong> @job.Salary €</div>

                        <div class="job-actions">
                            <a href="/Auth/Login" class="apply-btn">Apply Now</a>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <footer class="footer">
        © 2026 Student Job Platform. Built for students and employers.
    </footer>
</body>
</html>