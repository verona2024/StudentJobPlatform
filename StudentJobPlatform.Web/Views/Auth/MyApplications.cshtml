@model List<StudentJobPlatform.Models.Application>

@{
    ViewData["Title"] = "My Applications";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Applications</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #07111f, #0b1b33);
            color: white;
            min-height: 100vh;
            padding: 30px 20px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .header-box {
            background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.04));
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.18);
        }

            .header-box h1 {
                font-size: 34px;
                margin-bottom: 8px;
            }

            .header-box p {
                color: #cbd5e1;
            }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            text-decoration: none;
            color: white;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 700;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
        }

        .table-wrap {
            background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.04));
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            padding: 22px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.18);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 14px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        th {
            color: #93c5fd;
            font-size: 15px;
        }

        td {
            color: #e2e8f0;
        }

        .empty-box {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 24px;
            color: #cbd5e1;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/Auth/Dashboard" class="back-btn">Back to Dashboard</a>

        <div class="header-box">
            <h1>My Applications</h1>
            <p>All jobs you have applied for.</p>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-box">
                You have not applied to any job yet.
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Application ID</th>
                            <th>Job ID</th>
                            <th>Date Applied</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var application in Model)
                        {
                            <tr>
                                <td>@application.Id</td>
                                <td>@application.JobId</td>
                                <td>@application.ApplicationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@application.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>